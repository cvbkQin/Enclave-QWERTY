[Unit]
Description=Enclave feedback relay (A4)
After=network-online.target

[Service]
EnvironmentFile=/etc/enclave-feedback.env
ExecStart=/usr/bin/python3 /opt/enclave/feedback.py
User=www-data
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
