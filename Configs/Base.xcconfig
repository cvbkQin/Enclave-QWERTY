// 默认值。真机签名请复制 Local.xcconfig.template 为 Local.xcconfig 并填写自己的值。
BUNDLE_ID_PREFIX = com.example
DEVELOPMENT_TEAM =
APP_GROUP_ID = group.$(BUNDLE_ID_PREFIX).enclave
CODE_SIGN_STYLE = Automatic

// 内测版自带的接口：Local.xcconfig 里填 INTERNAL_* 那几项，打内测包时命令行加 INTERNAL_BUILD=YES 才会编进去。
// 开发者版、公测版（INTERNAL_BUILD=NO）这几项都是空的。Key 不进 Info.plist，由 scripts/gen-builtin-secrets.py 混淆后编进代码。
// 公测包（版本后缀 .1）打包时命令行加 PUBLIC_BUILD=YES：首页「摘要」旁显示「公测版」。
PUBLIC_BUILD = NO
INTERNAL_BUILD = NO
INTERNAL_BASE_URL =
INTERNAL_MODEL =
INTERNAL_API_KEY =
INTERNAL_ANSWER_BASE_URL =
INTERNAL_ANSWER_MODEL =
INTERNAL_ANSWER_API_KEY =

#include? "Local.xcconfig"

ENCLAVE_BUILTIN_BASE_URL_YES = $(INTERNAL_BASE_URL)
ENCLAVE_BUILTIN_MODEL_YES = $(INTERNAL_MODEL)
ENCLAVE_BUILTIN_ANSWER_BASE_URL_YES = $(INTERNAL_ANSWER_BASE_URL)
ENCLAVE_BUILTIN_ANSWER_MODEL_YES = $(INTERNAL_ANSWER_MODEL)
ENCLAVE_BUILTIN_BASE_URL = $(ENCLAVE_BUILTIN_BASE_URL_$(INTERNAL_BUILD))
ENCLAVE_BUILTIN_MODEL = $(ENCLAVE_BUILTIN_MODEL_$(INTERNAL_BUILD))
ENCLAVE_BUILTIN_ANSWER_BASE_URL = $(ENCLAVE_BUILTIN_ANSWER_BASE_URL_$(INTERNAL_BUILD))
ENCLAVE_BUILTIN_ANSWER_MODEL = $(ENCLAVE_BUILTIN_ANSWER_MODEL_$(INTERNAL_BUILD))
